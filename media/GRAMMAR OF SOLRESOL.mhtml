<td><b>Ldm=C2=AF</b>, <i>pupil, student [m];</i></td>
</tr>
<tr>
<td><b>Dmfd</b>, <i>man;</i></td>
<td><b>Dmfd=C2=AF</b>, <i>woman;</i></td>
</tr>
<tr>
